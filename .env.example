# ─────────────────────────────────────────────────────────────
#  Mulher dos Olhos de Deus — variáveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  Nunca coloque chaves secretas (service_role) em variáveis NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Endereço público do site (usado em SEO, sitemap e compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). A chave "anon"/"publishable" é pública
# e protegida pelas políticas RLS do arquivo supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Newsletter — escolha um provedor: buttondown | mailerlite | brevo
# (com o Brevo, o painel ganha a página Newsletter para enviar cartinhas)
# Estas chaves ficam apenas no servidor.
NEWSLETTER_PROVIDER=
BUTTONDOWN_API_KEY=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
BREVO_API_KEY=
BREVO_LIST_ID=
